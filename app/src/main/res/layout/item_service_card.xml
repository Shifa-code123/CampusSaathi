<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/txtOwnerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintTop_toTopOf="@id/imgProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgProfile"
        app:layout_constraintEnd_toStartOf="@id/btnFollow"/>

    <Button
        android:id="@+id/btnFollow"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Follow"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/cs_primary"
        android:background="@drawable/description_box"
        android:layout_marginEnd="14dp"
        app:layout_constraintTop_toTopOf="@id/imgProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgProfile"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photosPager"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/imgProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/dotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/photosPager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3dp"
            android:background="@drawable/dot_active"/>

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_margin="3dp"
            android:background="@drawable/dot_inactive"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/dotsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iconRating"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_star"/>

        <TextView
            android:id="@+id/txtRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"/>

        <ImageView
            android:id="@+id/iconComment"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="18dp"
            android:src="@drawable/ic_cs_comment"/>

        <TextView
            android:id="@+id/txtCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"/>

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="18dp"
            android:src="@drawable/ic_cs_save"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View details"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/cs_primary"
            android:background="@drawable/description_box"
            android:minHeight="36dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtServiceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/actionRow"/>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E8E8E8"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/txtServiceName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>