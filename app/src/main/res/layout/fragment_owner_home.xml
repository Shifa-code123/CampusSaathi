<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- PROFILE CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <!-- Profile Image -->
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profileImage"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:src="@drawable/default_avatar"
                            android:scaleType="centerCrop"
                            app:civ_border_width="1dp"
                            app:civ_border_color="#DDDDDD"/>

                        <!-- Text Section -->
                        <LinearLayout
                            android:layout_toEndOf="@id/profileImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/txtBusinessProfile"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Business profile"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtOwnerName"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Sunshine Mess"
                                android:textSize="11sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtOwnerType"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Mess Service Owner"
                                android:textSize="12sp"
                                android:textColor="#666"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Owner"
                                android:textSize="10sp"
                                android:textColor="#ffffff"
                                android:background="#FF9800"
                                android:paddingLeft="6dp"
                                android:paddingRight="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginTop="3dp"/>
                        </LinearLayout>

                        <!-- Verified Badge -->
                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal"
                            android:background="#E8F5E9"
                            android:padding="6dp"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="✔ Verified"
                                android:textColor="#2e7d32"
                                android:textSize="12sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- STATS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ROW 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="90dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="3dp"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_availability"/>

                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_marginStart="12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="2"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="#000"/>

                                    <TextView
                                        android:id="@+id/txtTotalServices"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Services"
                                        android:textSize="12sp"
                                        android:textColor="#666"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="90dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="3dp"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="12dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_star"/>

                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_marginStart="12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <LinearLayout
                                        android:orientation="horizontal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="4.5"
                                            android:textSize="18sp"
                                            android:textStyle="bold"
                                            android:textColor="#000"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" (45 Reviews)"
                                            android:textSize="12sp"
                                            android:textColor="#666"
                                            android:layout_marginStart="4dp"/>
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/txtRating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Average Rating"
                                        android:textSize="12sp"
                                        android:textColor="#666"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"/>

                <!-- BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddListing"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Add Service"
                        android:textColor="#ffffff"
                        android:background="@drawable/blue_button"
                        app:backgroundTint="@null"
                        android:layout_margin="5dp"/>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewListing"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="View Listing"
                        android:textColor="#ffffff"
                        android:background="@drawable/teal_button"
                        app:backgroundTint="@null"
                        android:layout_margin="5dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditListing"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Edit Services"
                        android:textColor="#ffffff"
                        android:background="@drawable/orange_button"
                        app:backgroundTint="@null"
                        android:layout_margin="5dp"/>


                </LinearLayout>
            </LinearLayout>

        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>