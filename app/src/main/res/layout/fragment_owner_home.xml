<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- PROFILE CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:id="@+id/txtBusinessProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Profile Image -->
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profileImage"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/default_avatar"
                            android:scaleType="centerCrop"
                            app:civ_border_width="1dp"
                            app:civ_border_color="@color/owner_divider"/>

                        <!-- Text Section -->
                        <LinearLayout
                            android:layout_toEndOf="@id/profileImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_centerVertical="true">

                            <TextView
                                android:id="@+id/txttBusinessProfile"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Business profile"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"/>

                            <TextView
                                android:id="@+id/txtOwnerName"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Sunshine Mess"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:alpha="0.87"/>

                            <TextView
                                android:id="@+id/txtOwnerType"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Mess Service Owner"
                                android:textSize="12sp"
                                android:textColor="@color/owner_text_secondary"/>

                        </LinearLayout>

                        <!-- Verified Badge -->
                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_verified"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Verified"
                                android:textColor="@color/owner_success"
                                android:textSize="12sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- STATS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        android:layout_margin="4dp">

                        <LinearLayout
                            android:id="@+id/cardTotalServices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_availability"
                                app:tint="@color/owner_primary"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                android:id="@+id/tvTotalServices"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Services"
                                android:textSize="12sp"
                                android:textColor="@color/owner_text_secondary"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        android:layout_margin="4dp">

                        <LinearLayout
                            android:id="@+id/cardRating"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow_star"
                                android:layout_marginBottom="8dp"/>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.0"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface"/>

                                <TextView
                                    android:id="@+id/tvTotalReviews"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="(0)"
                                    android:textSize="12sp"
                                    android:textColor="@color/owner_text_secondary"
                                    android:layout_marginStart="4dp"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Rating"
                                android:textSize="12sp"
                                android:textColor="@color/owner_text_secondary"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp"/>

                <!-- BUTTONS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddListing"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Add New Service"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewListing"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="View Listing"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp"
                        android:layout_margin="4dp"
                        app:strokeColor="?attr/colorPrimary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditListing"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Edit Services"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp"
                        android:layout_margin="4dp"
                        app:strokeColor="?attr/colorPrimary"/>

                </LinearLayout>
            </LinearLayout>

        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
