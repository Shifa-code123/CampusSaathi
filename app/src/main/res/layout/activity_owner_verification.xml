<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- LOGO -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/campus_logo" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/owner_verification"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginTop="12dp" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/owner_verification_subtitle"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- ================= COMMON DETAILS ================= -->
        <LinearLayout
            android:id="@+id/layoutCommonVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/full_name"
                android:textStyle="bold"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_number"
                android:textStyle="bold"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:inputType="phone"
                android:background="@android:drawable/edit_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/same_number"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_role"
                android:textStyle="bold"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/role_owner"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbCaretaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/role_caretaker"
                    android:layout_marginStart="12dp" />

                <RadioButton
                    android:id="@+id/rbManager"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/role_manager"
                    android:layout_marginStart="12dp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id_proof"
                android:textStyle="bold"
                android:textColor="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F2F2F2"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/id_proof_hint"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnUploadId"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/upload_id"
                    android:textAllCaps="false"
                    android:drawableLeft="@android:drawable/ic_menu_upload"
                    android:backgroundTint="#E0E0E0"
                    android:textColor="#1976D2" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id_safe"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="20dp" />
        </LinearLayout>

        <!-- ================= ROOM / PG ================= -->
        <LinearLayout
            android:id="@+id/layoutRoomVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_proof"
                android:textStyle="bold"
                android:textColor="#000000" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/electricity_bill" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rent_agreement" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hotel_letter" />
            </RadioGroup>

            <Button
                android:id="@+id/btnUploadRoomProof"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/upload_property"
                android:textAllCaps="false"
                android:drawableLeft="@android:drawable/ic_menu_upload"
                android:backgroundTint="#E0E0E0"
                android:textColor="#1976D2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_any"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- ================= MESS ================= -->
        <LinearLayout
            android:id="@+id/layoutMessVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mess Proof"
                android:textStyle="bold"
                android:textColor="#000000" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FSSAI License" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shop Act License" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kitchen Rent Agreement" />
            </RadioGroup>

            <Button
                android:id="@+id/btnUploadMessProof"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Upload Mess Proof"
                android:textAllCaps="false"
                android:drawableLeft="@android:drawable/ic_menu_upload"
                android:backgroundTint="#E0E0E0"
                android:textColor="#1976D2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload any one document"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- ================= TUITION ================= -->
        <LinearLayout
            android:id="@+id/layoutTuitionVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qualification Proof"
                android:textStyle="bold"
                android:textColor="#000000" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Degree Certificate" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience Letter" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Institute Registration" />
            </RadioGroup>

            <Button
                android:id="@+id/btnUploadTuitionProof"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Upload Qualification Proof"
                android:textAllCaps="false"
                android:drawableLeft="@android:drawable/ic_menu_upload"
                android:backgroundTint="#E0E0E0"
                android:textColor="#1976D2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload any one document"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- CHECKBOX & SUBMIT -->
        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_info"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSubmitVerification"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/submit_verification"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3" />

    </LinearLayout>
</ScrollView>
