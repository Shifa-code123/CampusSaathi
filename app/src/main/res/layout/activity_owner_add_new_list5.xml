<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOOLBAR ===== -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/owner_primary"
            app:title="Add New Listing"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_menu" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- STEP INDICATOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 5 of 6: Photos"
                        android:textStyle="bold"
                        android:textColor="@color/owner_text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:text="1"
                            android:background="@drawable/step_done"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="@color/owner_primary"/>

                        <TextView
                            android:text="2"
                            android:background="@drawable/step_done"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="@color/owner_primary"/>

                        <TextView
                            android:text="3"
                            android:background="@drawable/step_done"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="@color/owner_primary"/>

                        <TextView
                            android:text="4"
                            android:background="@drawable/step_done"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="@color/owner_primary"/>

                        <TextView
                            android:text="5"
                            android:background="@drawable/step_active"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="@color/owner_divider"/>

                        <TextView android:text="6"
                            android:background="@drawable/step_inactive"
                            android:textColor="@color/owner_text_secondary"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- PHOTO CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:background="@drawable/card_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Property Photos"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/owner_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Upload at least 3 photos (max 5)"
                        android:textSize="12sp"
                        android:textColor="@color/owner_text_secondary" />

                    <!-- EMPTY GRID -->
                    <GridLayout
                        android:id="@+id/gridImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="3"
                        android:useDefaultMargins="true"/>

                    <!-- ADD IMAGE BUTTON -->
                    <LinearLayout
                        android:id="@+id/btnAddImage"
                        android:layout_marginTop="12dp"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/edit_bg">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/owner_primary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+ Add Photo"
                            android:textSize="12sp"
                            android:textColor="@color/owner_primary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• Avoid blurry or duplicate photos"
                        android:textSize="11sp"
                        android:textColor="@color/owner_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Personal faces are not allowed"
                        android:textSize="11sp"
                        android:textColor="@color/owner_text_secondary" />
                </LinearLayout>

                <!-- SUBMIT -->
                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_margin="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="next"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/owner_primary" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:itemBackground="@drawable/nav_item_background"
        app:menu="@menu/owner_menu_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>