<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2196F3"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Listing"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- STEP INDICATOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 4 of 5: Photos"
                android:textStyle="bold"
                android:textColor="#555"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <!-- Step 1 DONE -->
                <TextView
                    android:text="1"
                    android:background="@drawable/step_done"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:background="#2979FF"/>

                <!-- Step 2 DONE -->
                <TextView
                    android:text="2"
                    android:background="@drawable/step_done"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:background="#2979FF"/>

                <!-- Step 3 DONE -->
                <TextView
                    android:text="3"
                    android:background="@drawable/step_done"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:background="#2979FF"/>

                <!-- Step 4 DONE -->
                <TextView
                    android:text="4"
                    android:background="@drawable/step_done"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:background="#2979FF"/>

                <!-- Step 5 ACTIVE -->
                <TextView
                    android:text="5"
                    android:background="@drawable/step_active"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:background="#2979FF"/>

                <TextView android:text="6"
                    android:background="@drawable/step_active"
                    android:textColor="#fff"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

            </LinearLayout>


            <ImageView
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:src="@drawable/step_4" />
        </LinearLayout>

        <!-- PHOTO CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/card_border">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Property Photos"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Upload at least 3 photos (max 5)"
                android:textSize="12sp"
                android:textColor="#777" />

            <!-- EMPTY GRID -->
            <GridLayout
                android:id="@+id/gridImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="3"
                android:useDefaultMargins="true"/>

            <!-- ADD IMAGE BUTTON -->
            <LinearLayout
                android:id="@+id/btnAddImage"
                android:layout_marginTop="12dp"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/edit_bg">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_add" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="+ Add Photo"
                    android:textSize="12sp"
                    android:textColor="#2196F3" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Avoid blurry or duplicate photos"
                android:textSize="11sp"
                android:textColor="#999" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Personal faces are not allowed"
                android:textSize="11sp"
                android:textColor="#999" />
        </LinearLayout>




        <!-- ADDRESS DETAILS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/card_border">

            <TextView   android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address Details"
                android:textStyle="bold"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtArea"
                android:layout_marginTop="8dp"
                android:hint="Area / Locality"
                android:background="@drawable/edit_bg"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtLandmark"
                android:layout_marginTop="8dp"
                android:hint="Landmark (Optional)"
                android:background="@drawable/edit_bg"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtCity"
                android:layout_marginTop="8dp"
                android:hint="City"
                android:background="@drawable/edit_bg"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- SUBMIT -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_margin="16dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Submit Listing"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="#2196F3" />

    </LinearLayout>
</ScrollView>
