<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2196F3"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_centerInParent="true"
                android:text="Listing Submission"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

        <!-- MAIN CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:radius="14dp"
            android:elevation="4dp">

            <LinearLayout
                android:id="@+id/cardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pending Approval -->
                <ImageView
                    android:id="@+id/ivPending"
                    android:layout_width="160dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:src="@drawable/illustration_pending"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvPendingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="Pending Approval"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/tvPendingDesc"
                    android:layout_height="match_parent"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:text="Your listing has been submitted and is under review. This usually takes 24-48 hours."
                    android:textAlignment="center"
                    android:textSize="13sp"/>

                <!-- Buttons -->
                <LinearLayout
                    android:id="@+id/layoutButtons"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnDashboard"
                        android:text="View Owner Dashboard"
                        android:backgroundTint="#2979FF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnEditListing"
                        android:text="Edit Listing"
                        android:backgroundTint="#2979FF"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNote"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:text="Note: Your listing is not yet visible to students."
                    android:textAlignment="center"
                    android:textSize="12sp"/>

                <!-- Divider -->
                <View
                    android:id="@+id/divider1"
                    android:layout_marginVertical="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <!-- Location Header -->
                <LinearLayout
                    android:id="@+id/layoutLocationHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLocationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Location"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/btnEditLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Edit"
                        android:textColor="#2979FF"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Location Details -->
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:text="Shivaji Nagar\nLandmark: Axis / MIDC Road\nCity: Khamgaon"
                    android:textSize="13sp"/>

                <ImageView
                    android:id="@+id/ivMap"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/sample_map"/>

                <!-- Divider -->
                <View
                    android:id="@+id/divider2"
                    android:layout_marginVertical="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <!-- Photos Header -->
                <LinearLayout
                    android:id="@+id/layoutPhotosHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPhotosTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Photos"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/btnEditPhotos"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Edit"
                        android:textColor="#2979FF"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Photos -->
                <LinearLayout
                    android:id="@+id/layoutPhotos"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivPhoto1"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_room1"/>

                    <ImageView
                        android:id="@+id/ivPhoto2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_room2"/>

                    <ImageView
                        android:id="@+id/ivPhoto3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/sample_room3"
                        android:scaleType="center" />

                    <ImageView
                        android:id="@+id/ivPhoto4"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/sample_room4"
                        android:scaleType="center" />

                    <ImageView
                        android:id="@+id/btnAddPhoto"
                        android:layout_width="73dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_add" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
