<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- MAIN CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:radius="14dp"
            android:elevation="4dp"
            app:cardBackgroundColor="@color/owner_card_bg"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:id="@+id/cardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pending Approval -->
                <ImageView
                    android:id="@+id/ivPending"
                    android:layout_width="160dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:src="@drawable/illustration_pending"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvPendingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="Pending Approval"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/owner_text_primary"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/tvPendingDesc"
                    android:layout_height="match_parent"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:text="Your listing has been submitted and is under review. This usually takes 24-48 hours."
                    android:textAlignment="center"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="13sp"/>

                <!-- Buttons -->
                <LinearLayout
                    android:id="@+id/layoutButtons"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnDashboard"
                        android:text="View Owner Dashboard"
                        android:backgroundTint="@color/owner_primary"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/addanotherservice"
                        android:text="Add another service"
                        android:backgroundTint="@color/owner_primary"
                        android:textColor="@color/white"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNote"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:text="Note: Your listing is not yet visible to students."
                    android:textAlignment="center"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="12sp"/>

                <!-- Divider -->
                <View
                    android:id="@+id/divider1"
                    android:layout_marginVertical="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/owner_divider"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>