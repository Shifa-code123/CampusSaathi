<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        >

        <!-- HEADER -->
        <include
            android:id="@+id/header"
            layout="@layout/layout_cs_header"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- SCROLL CONTENT -->

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- IMAGE SLIDER -->

                <FrameLayout
                    android:id="@+id/sliderContainer"
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/imageSlider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <LinearLayout
                        android:id="@+id/dotsLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="bottom|center"
                        android:layout_marginBottom="12dp"/>

                </FrameLayout>

                <!-- SERVICE INFO -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/serviceInfoCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/description_box"
                    android:padding="12dp"
                    app:layout_constraintTop_toBottomOf="@id/sliderContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txtServiceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Name"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/imgOwnerProfile"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/txtServiceName"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/txtOwnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Owner Name"
                        app:layout_constraintStart_toEndOf="@id/imgOwnerProfile"
                        app:layout_constraintTop_toTopOf="@id/imgOwnerProfile"
                        app:layout_constraintBottom_toBottomOf="@id/imgOwnerProfile"/>

                    <!-- Buttons -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/imgOwnerProfile"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <Button
                            android:id="@+id/btnDirection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/cs_primary_blue"
                            android:layout_weight="1"
                            android:text="Direction"/>

                        <Button
                            android:id="@+id/btnCall"
                            android:layout_width="0dp"
                            android:backgroundTint="@color/cs_primary_blue"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Call"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- DESCRIPTION -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/descriptionCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/description_box"
                    android:padding="12dp"
                    app:layout_constraintTop_toBottomOf="@id/serviceInfoCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txtDescriptionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Description here"
                        app:layout_constraintTop_toBottomOf="@id/txtDescriptionTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ⭐ RATE US -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ratingCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/description_box"
                    android:padding="12dp"
                    app:layout_constraintTop_toBottomOf="@id/descriptionCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txtRateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate Us"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <Button
                        android:id="@+id/btnRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Give Rating"
                        android:backgroundTint="@color/cs_primary_blue"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/txtRateTitle"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <!-- ⭐ Stars -->

                    <RatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:visibility="gone"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/btnRate"
                        app:layout_constraintStart_toStartOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER -->

    <include
        android:id="@+id/studentDrawer"
        layout="@layout/layout_student_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>