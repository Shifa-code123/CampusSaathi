<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- ===== TOOLBAR ===== -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2196F3"
            app:title="Add New Listing"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@drawable/ic_menu" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== MAIN CARD ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- ===== STEP TITLE ===== -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Step 4 of 6: Location and Reachability"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <!-- ===== STEPS (6 TOTAL, 4 ACTIVE) ===== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="1"
                                android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/step_done" />

                            <View android:layout_width="20dp" android:layout_height="2dp" android:background="#2979FF" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="2"
                                android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/step_done" />

                            <View android:layout_width="20dp" android:layout_height="2dp" android:background="#2979FF" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="3"
                                android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/step_done" />

                            <View android:layout_width="20dp" android:layout_height="2dp" android:background="#2979FF" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="4"
                                android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/step_active" />

                            <View android:layout_width="20dp" android:layout_height="2dp" android:background="#CCCCCC" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="5"
                                android:gravity="center"
                                android:background="@drawable/step_inactive" />

                            <View android:layout_width="20dp" android:layout_height="2dp" android:background="#CCCCCC" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="6"
                                android:gravity="center"
                                android:background="@drawable/step_inactive" />
                        </LinearLayout>

                        <!-- ===== MAP (COMPULSORY FOR ALL) ===== -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Select Location on Map"
                            android:textStyle="bold"
                            android:drawableStart="@drawable/ic_location"
                            android:drawablePadding="8dp" />

                        <FrameLayout
                            android:id="@+id/mapContainer"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_map">

                            <!-- Placeholder map -->
                            <fragment
                                android:id="@+id/map"
                                android:name="com.google.android.gms.maps.SupportMapFragment"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"/>

                            <ImageView
                                android:id="@+id/btnGps"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_circle_white"
                                android:padding="6dp"
                                android:src="@drawable/ic_gps" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Distance from campus: 0.0 km"
                            android:textSize="12sp" />

                        <!-- ===== COMMON ADDRESS DETAILS ===== -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Address Details"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/etArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Area / Locality"
                            android:background="@drawable/edit_bg" />

                        <EditText
                            android:id="@+id/etLandmark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Landmark (Optional)"
                            android:background="@drawable/edit_bg"
                            android:layout_marginTop="8dp" />

                        <EditText
                            android:id="@+id/etCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="City"
                            android:background="@drawable/edit_bg"
                            android:layout_marginTop="8dp" />

                        <EditText
                            android:id="@+id/etPincode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Pincode"
                            android:inputType="number"
                            android:background="@drawable/edit_bg"
                            android:layout_marginTop="8dp" />

                        <!-- ===== ROOM / PG / HOSTEL LOCATION DETAILS ===== -->
                        <!-- ================= ROOM / PG / HOSTEL ================= -->
                        <LinearLayout
                            android:id="@+id/layoutRoomStep4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Room / PG / Hostel Details"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp" />

                            <CheckBox
                                android:id="@+id/cbNearCampus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Near Campus" />

                            <CheckBox
                                android:id="@+id/cbMarketNearby"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Market Nearby" />

                            <CheckBox
                                android:id="@+id/cbHospitalNearby"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hospital / Medical Nearby" />

                        </LinearLayout>

                        <!-- ===== MESS LOCATION DETAILS ===== -->
                        <LinearLayout
                            android:id="@+id/layoutMessStep4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mess Service Area"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp" />

                            <EditText
                                android:id="@+id/etServiceRadius"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Service Radius (km)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg" />

                            <CheckBox
                                android:id="@+id/cbHomeDelivery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home Delivery Available" />

                            <CheckBox
                                android:id="@+id/cbPickupAvailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pickup Available" />

                        </LinearLayout>


                        <!-- ===== TUITION LOCATION DETAILS ===== -->
                    <!-- ===== TUITION LOCATION DETAILS ===== -->
                    <LinearLayout
                        android:id="@+id/layoutTuitionStep4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tuition / Coaching Access"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <CheckBox
                            android:id="@+id/cbMainRoad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Near Main Road" />

                        <CheckBox
                            android:id="@+id/cbSafeArea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safe for Evening Batches" />

                        <CheckBox
                            android:id="@+id/cbParkingAvailable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student Parking Available" />

                    </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== NEXT BUTTON ===== -->
                <Button
                    android:id="@+id/btnNextStep4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Next"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2979FF" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemBackground="@drawable/nav_item_background"
        app:menu="@menu/owner_menu_drawer"/>


</androidx.drawerlayout.widget.DrawerLayout>
