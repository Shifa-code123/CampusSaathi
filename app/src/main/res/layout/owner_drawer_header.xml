<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="180dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/owner_background">

    <ImageView
        android:id="@+id/headerLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/campus_logo"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/headerProfile"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/default_avatar"/>

        <LinearLayout
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/headerName"
                android:text="Owner Name"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/owner_text_primary"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/headerRole"
                android:text="Service Owner"
                android:textSize="13sp"
                android:textColor="@color/owner_text_secondary"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/headerVerified"
                android:text="✔ Verified"
                android:textColor="@color/owner_success"
                android:textStyle="bold"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>