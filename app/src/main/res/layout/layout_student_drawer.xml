<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/drawer_border">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/drawerTop"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/description_box"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivDrawerLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/campus_logo"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CampusSaathi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/follow_button_blue"
            android:layout_marginStart="12dp"/>
    </LinearLayout>


    <!-- PROFILE SECTION -->
    <LinearLayout
        android:id="@+id/profileSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/drawerTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profileImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/cs_primary"/>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp"/>

    </LinearLayout>


    <!-- MENU ITEMS -->
    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/profileSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->
        <TextView
            android:id="@+id/menuHome"
            style="@style/DrawerItemStyle"
            android:text="Home"
            android:drawableStart="@drawable/cs_ic_footer_home" />

        <!-- My Profile -->
        <TextView
            android:id="@+id/menuProfile"
            style="@style/DrawerItemStyle"
            android:text="My Profile"
            android:drawableStart="@drawable/ic_profile"/>

        <!-- Saved -->
        <TextView
            android:id="@+id/menuSaved"
            style="@style/DrawerItemStyle"
            android:text="Saved Services"
            android:drawableStart="@drawable/ic_saved"/>

        <!-- Volunteer -->
        <TextView
            android:id="@+id/menuVolunteer"
            style="@style/DrawerItemStyle"
            android:text="Volunteer Program"
            android:drawableStart="@drawable/ic_volunteer"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="6dp"/>

        <!-- About -->
        <TextView
            android:id="@+id/menuAbout"
            style="@style/DrawerItemStyle"
            android:text="About CampusSaathi"
            android:drawableStart="@drawable/ic_cap"/>

        <!-- Help -->
        <TextView
            android:id="@+id/menuHelp"
            style="@style/DrawerItemStyle"
            android:text="Help and Support"
            android:drawableStart="@drawable/ic_help"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="6dp"/>

        <!-- Logout -->
        <TextView
            android:id="@+id/menuLogout"
            style="@style/DrawerItemStyle"
            android:text="Logout"
            android:drawableStart="@drawable/ic_logout"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>