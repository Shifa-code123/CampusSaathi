<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOOLBAR ===== -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/owner_primary"
            app:title="Add New Listing"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_menu" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- STEP TEXT -->
                <TextView
                    android:layout_margin="16dp"
                    android:text="Step 6 of 6: Review And Submit"
                    android:textStyle="bold"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- STEP INDICATOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:text="1"
                        android:background="@drawable/step_done"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                    <View android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:background="@color/owner_primary"/>

                    <TextView android:text="2"
                        android:background="@drawable/step_done"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                    <View android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:background="@color/owner_primary"/>

                    <TextView android:text="3"
                        android:background="@drawable/step_done"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                    <View android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:background="@color/owner_primary"/>

                    <TextView android:text="4"
                        android:background="@drawable/step_done"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                    <View android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:background="@color/owner_primary"/>

                    <TextView android:text="5"
                        android:background="@drawable/step_done"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                    <View android:layout_width="20dp"
                        android:layout_height="2dp"
                        android:background="@color/owner_primary"/>

                    <TextView android:text="6"
                        android:background="@drawable/step_active"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                </LinearLayout>

                <!-- PROPERTY INFO -->
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_margin="12dp"
                    android:padding="16dp"
                    android:background="@drawable/card_border"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Property Info"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/owner_text_primary"
                            android:layout_alignParentStart="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/btnEditProperty"
                            android:text="Edit"
                            android:textColor="@color/owner_primary"
                            android:textSize="13sp"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txtPropertyInfo"
                        android:layout_marginTop="6dp"
                        android:text="--"
                        android:textColor="@color/owner_text_primary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- RENT -->
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_margin="12dp"
                    android:padding="16dp"
                    android:background="@drawable/card_border"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rent And Availability"
                            android:textColor="@color/owner_text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/btnEditRent"
                            android:text="Edit"
                            android:textColor="@color/owner_primary"
                            android:textSize="13sp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txtRentInfo"
                        android:layout_marginTop="6dp"
                        android:text="--"
                        android:textColor="@color/owner_text_primary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- AMENITIES -->
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_margin="12dp"
                    android:padding="16dp"
                    android:background="@drawable/card_border"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amenities"
                            android:textColor="@color/owner_text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/btnEditAmenities"
                            android:text="Edit"
                            android:textColor="@color/owner_primary"
                            android:textSize="13sp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txtAmenities"
                        android:layout_marginTop="6dp"
                        android:text="--"
                        android:textColor="@color/owner_text_primary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- LOCATION -->
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_margin="12dp"
                    android:padding="16dp"
                    android:background="@drawable/card_border"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textColor="@color/owner_text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/btnEditLocation"
                            android:text="Edit"
                            android:textColor="@color/owner_primary"
                            android:textSize="13sp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txtLocation"
                        android:layout_marginTop="6dp"
                        android:text="--"
                        android:textColor="@color/owner_text_primary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- CONFIRM -->
                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/cbConfirm"
                    android:layout_margin="16dp"
                    android:textColor="@color/owner_text_primary"
                    android:text="I confirm that the information provided is accurate."/>

                <!-- BUTTONS -->
                <LinearLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_margin="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnDraft"
                        android:layout_weight="1"
                        android:text="Save as Draft"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/owner_primary"
                        android:textColor="@color/white"/>

                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Submit for Approval"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/owner_primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:itemBackground="@drawable/nav_item_background"
        app:menu="@menu/owner_menu_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>