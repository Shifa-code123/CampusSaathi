<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- TOOLBAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2196F3"
            app:title="Add New Listing"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@drawable/ic_menu" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- HEADER -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 2 of 6: Pricing and Availability"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- STEPS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="12dp">

                            <TextView android:layout_width="28dp" android:layout_height="28dp"
                                android:text="1" android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/step_done"/>

                            <View android:layout_width="16dp" android:layout_height="2dp"
                                android:background="#2979FF"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp"
                                android:text="2" android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/step_active"/>

                            <View android:layout_width="16dp" android:layout_height="2dp"
                                android:background="#CCCCCC"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp"
                                android:text="3" android:gravity="center"
                                android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp"
                                android:background="#CCCCCC"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp"
                                android:text="4" android:gravity="center"
                                android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp"
                                android:background="#CCCCCC"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp"
                                android:text="5" android:gravity="center"
                                android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp"
                                android:background="#CCCCCC"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp"
                                android:text="6" android:gravity="center"
                                android:background="@drawable/step_inactive"/>
                        </LinearLayout>

                        <!-- ================================================= -->
                        <!-- ================================================= -->
                        <!-- ROOM STEP 2 : RENT, AVAILABILITY & ROOMS COUNT -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutRoomStep2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp"
                            android:visibility="visible">

                            <!-- RENT DETAILS -->
                            <TextView
                                android:text="Rent Details"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/etRoomRent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Monthly Rent (₹)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"/>

                            <EditText
                                android:id="@+id/etRoomDeposit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Security Deposit (Optional)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"
                                android:layout_marginTop="8dp"/>

                            <!-- RENT TYPE -->
                            <TextView
                                android:text="Rent Type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"/>

                            <RadioGroup
                                android:id="@+id/rgRentType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:text="Per Room"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <RadioButton
                                    android:text="Per Bed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </RadioGroup>

                            <!-- AVAILABILITY -->
                            <TextView
                                android:text="Availability"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"/>

                            <RadioGroup
                                android:id="@+id/rgAvailability"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:text="Vacant"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <RadioButton
                                    android:text="Full"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </RadioGroup>

                            <!-- ROOM COUNT DETAILS -->
                            <TextView
                                android:id="@+id/tvRoomCountTitle"
                                android:text="Room Details"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"/>

                            <EditText
                                android:id="@+id/etTotalUnits"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Total Rooms"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"/>

                            <EditText
                                android:id="@+id/etAvailableUnits"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Available Rooms"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"
                                android:layout_marginTop="6dp"/>

                            <!-- AVAILABLE FROM -->
                            <EditText
                                android:id="@+id/etAvailableFrom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Available From"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"
                                android:layout_marginTop="10dp"/>

                        </LinearLayout>

                        <!-- ================================================= -->
                        <!-- MESS STEP 2 -->
                        <!-- ================================================= -->
                        <!-- ================================================= -->
                        <!-- MESS STEP 2 : PRICING -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutMessStep2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="24dp"
                            android:visibility="visible">

                            <TextView
                                android:text="Mess Pricing"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <!-- Monthly Charges -->
                            <EditText
                                android:id="@+id/etMessMonthlyCharge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Monthly Charges (₹)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"/>

                            <!-- Daily Charges (Optional) -->
                            <EditText
                                android:id="@+id/etMessDailyCharge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Daily Charges (Optional)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>


                        <!-- ================================================= -->
                        <!-- ================================================= -->
                        <!-- TUITION STEP 2 : FEES & DURATION -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutTuitionStep2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="24dp"
                            android:visibility="visible">

                            <TextView
                                android:text="Tuition Fees"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <!-- Fees Amount -->
                            <EditText
                                android:id="@+id/etTuitionFees"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Fees Amount (₹)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"/>

                            <!-- Course Duration -->
                            <EditText
                                android:id="@+id/etCourseDuration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Course Duration (Months)"
                                android:inputType="number"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"
                                android:layout_marginTop="8dp"/>

                        </LinearLayout>

                        <!-- NEXT BUTTON -->
                        <Button
                            android:id="@+id/btnNextStep2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Next"
                            android:layout_marginTop="24dp"
                            android:backgroundTint="#2979FF"
                            android:textColor="#FFFFFF"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemBackground="@drawable/nav_item_background"
        app:menu="@menu/owner_menu_drawer"/>


</androidx.drawerlayout.widget.DrawerLayout>
