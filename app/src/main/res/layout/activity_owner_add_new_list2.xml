<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- ===== TOOLBAR ===== -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3"
        app:title="Add New Listing"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_menu"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- ===== CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 2 of 5: Rent and Availability"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <!-- ===== STEPS ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:text="1"
                            android:background="@drawable/step_done"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#2979FF"/>

                        <TextView
                            android:text="2"
                            android:background="@drawable/step_active"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView android:text="3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView
                            android:text="4"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView
                            android:text="5"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>
                    </LinearLayout>

                    <!-- ===== RENT DETAILS ===== -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        android:background="#EAF2FF"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rent Details"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:drawableStart="@drawable/ic_rent"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"/>


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Monthly Rent (₹) *"
                                android:layout_marginTop="8dp"/>

                            <!-- Monthly Rent -->
                            <EditText
                                android:id="@+id/etMonthlyRent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edit_bg"
                                android:hint="₹"
                                android:inputType="number"
                                android:padding="10dp" />

                            <!-- Security Deposit -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Security Deposit (₹) (Optional)"
                                android:layout_marginTop="8dp"/>

                            <EditText
                                android:id="@+id/etSecurityDeposit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edit_bg"
                                android:hint="₹"
                                android:inputType="number"
                                android:padding="10dp" />

                            <!-- Rent Type -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Rent Type *"
                                android:layout_marginTop="10dp"/>

                            <RadioGroup
                                android:id="@+id/rgRentType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:id="@+id/rbPerRoom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Per room"/>

                                <RadioButton
                                    android:id="@+id/rbPerBed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Per bed"/>
                            </RadioGroup>

                            <!-- ===== AVAILABILITY ===== -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                android:background="#EAF2FF"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <!-- Availability Title -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Availability"
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:drawableStart="@drawable/ic_availability"
                                        android:drawablePadding="8dp"
                                        android:gravity="center_vertical"/>

                                    <!-- Availability Status -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Availability Status"
                                        android:layout_marginTop="8dp"/>

                                    <RadioGroup
                                        android:id="@+id/rgAvailabilityStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <RadioButton
                                            android:id="@+id/rbVacant"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Vacant"/>

                                        <RadioButton
                                            android:id="@+id/rbFull"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Full"/>
                                    </RadioGroup>

                                    <!-- Available From -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Available From"
                                        android:layout_marginTop="8dp"/>

                                    <EditText
                                        android:id="@+id/etAvailableFrom"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Select date"
                                        android:focusable="false"
                                        android:clickable="true"
                                        android:background="@drawable/edit_bg"
                                        android:drawableEnd="@drawable/ic_calendar"
                                        android:padding="10dp"/>

                                    <!-- Minimum Stay -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Minimum Stay (Months) (Optional)"
                                        android:layout_marginTop="10dp"/>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:background="@drawable/bg_counter"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">

                                        <TextView
                                            android:id="@+id/btnMinMinus"
                                            android:layout_width="48dp"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:text="-" />

                                        <View
                                            android:layout_width="1dp"
                                            android:layout_height="match_parent"
                                            android:background="#BDBDBD"/>

                                        <TextView
                                            android:id="@+id/txtMinCount"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:gravity="center"
                                            android:text="1"
                                            android:textStyle="bold"/>

                                        <View
                                            android:layout_width="1dp"
                                            android:layout_height="match_parent"
                                            android:background="#BDBDBD"/>

                                        <TextView
                                            android:id="@+id/btnMinPlus"
                                            android:layout_width="48dp"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:text="+" />
                                    </LinearLayout>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>



                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#2979FF"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
