<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- ===== TOOLBAR ===== -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3"
        app:title="Add New Listing"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_menu"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== MAIN CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Step Title -->
                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:text="Step 3 of 5: Amenities"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <!-- ===== STEPS ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:text="1"
                            android:background="@drawable/step_done"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View android:layout_width="20dp" android:layout_height="2dp" android:background="#2979FF"/>

                        <TextView
                            android:text="2"
                            android:background="@drawable/step_done"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View android:layout_width="20dp" android:layout_height="2dp" android:background="#2979FF"/>

                        <TextView
                            android:text="3"
                            android:background="@drawable/step_active"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View android:layout_width="20dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView
                            android:text="4"
                            android:background="@drawable/step_inactive"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View android:layout_width="20dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView
                            android:text="5"
                            android:background="@drawable/step_inactive"
                            android:gravity="center"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                    </LinearLayout>

                    <!-- ===== BASIC AMENITIES ===== -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        android:background="#EAF2FF"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Basic Amenities"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:drawableStart="@drawable/ic_basic_amenities"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"/>

                            <CheckBox
                                android:id="@+id/cbWifi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wi-Fi"
                                android:checked="true"/>

                            <CheckBox
                                android:id="@+id/cbWater"
                                android:layout_width="wrap_content"
                                android:layout_height="29dp"
                                android:checked="true"
                                android:text="Water Supply" />

                            <CheckBox
                                android:id="@+id/cbElectricity"
                                android:layout_width="wrap_content"
                                android:layout_height="31dp"
                                android:checked="true"
                                android:text="Electricity Included" />

                            <CheckBox
                                android:id="@+id/cbStudyTable"
                                android:layout_width="wrap_content"
                                android:layout_height="29dp"
                                android:text="Study Table" />

                            <CheckBox
                                android:id="@+id/cbBed"
                                android:layout_width="94dp"
                                android:layout_height="22dp"
                                android:text="Bed" />

                            <CheckBox
                                android:id="@+id/cbCupboard"
                                android:layout_width="wrap_content"
                                android:layout_height="21dp"
                                android:text="Cupboard" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ===== FACILITY AMENITIES ===== -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:background="#EAF2FF"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Facility Amenities"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:drawableStart="@drawable/ic_facility"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"/>

                            <!-- Hot Water -->
                            <CheckBox
                                android:id="@+id/cbHotWater"
                                android:layout_width="192dp"
                                android:layout_height="36dp"
                                android:checked="true"
                                android:text="Hot Water" />

                            <!-- Attached / Common -->
                            <RadioGroup
                                android:id="@+id/rgBathroomType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginStart="24dp">

                                <RadioButton
                                    android:id="@+id/rbAttached"
                                    android:layout_width="wrap_content"
                                    android:layout_height="27dp"
                                    android:text="Attached" />

                                <RadioButton
                                    android:id="@+id/rbCommon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Common" />
                            </RadioGroup>

                            <!-- Parking -->
                            <CheckBox
                                android:id="@+id/cbParking"
                                android:layout_width="wrap_content"
                                android:layout_height="18dp"
                                android:checked="true"
                                android:text="Parking" />

                            <!-- Laundry -->
                            <CheckBox
                                android:id="@+id/cbLaundry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Laundry"
                                android:checked="true"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ===== FOOD ===== -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:background="#EAF2FF"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Title + Switch -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Food (Optional)"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    android:drawableStart="@drawable/ic_food"
                                    android:drawablePadding="8dp"
                                    android:gravity="center_vertical"/>

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>

                                <Switch
                                    android:id="@+id/switchFood"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"/>
                            </LinearLayout>

                            <!-- Mess Available -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mess Available"
                                android:layout_marginTop="8dp"/>

                            <!-- Veg / Non-Veg / Both -->
                            <RadioGroup
                                android:id="@+id/rgFoodType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:id="@+id/rbVeg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="29dp"
                                    android:text="Veg" />

                                <RadioButton
                                    android:id="@+id/rbNonVeg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Non-Veg" />

                                <RadioButton
                                    android:id="@+id/rbBoth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="26dp"
                                    android:text="Both" />
                            </RadioGroup>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- NEXT BUTTON -->
                    <Button
                        android:id="@+id/btnNextAmenities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#2979FF"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

