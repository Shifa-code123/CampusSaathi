<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3"
        app:title="Add New Listing"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_menu"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- STEP TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 3 of 6: Amenities and Services"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <!-- STEPS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="1" android:gravity="center"
                            android:textColor="#FFFFFF" android:background="@drawable/step_done"/>

                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#2979FF"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="2" android:gravity="center"
                            android:textColor="#FFFFFF" android:background="@drawable/step_done"/>

                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#2979FF"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="3" android:gravity="center"
                            android:textColor="#FFFFFF" android:background="@drawable/step_active"/>

                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="4" android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="5" android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp"
                            android:text="6" android:gravity="center"
                            android:background="@drawable/step_inactive"/>
                    </LinearLayout>

                    <!-- ================================================= -->
                    <!-- ROOM / PG / HOSTEL -->
                    <!-- ================================================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room / PG / Hostel"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"/>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wi-Fi"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water Supply"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Electricity Included"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fan and Light"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bed and Mattress"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Study Table"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cupboard / Wardrobe"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bathroom and Hygiene"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hot Water"/>
                    <RadioGroup android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Attached"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Common"/>
                    </RadioGroup>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Cleaning"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Western / Indian Toilet"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="House Rules"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visitors Allowed"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outside Food Allowed"/>

                    <!-- ================================================= -->
                    <!-- MESS -->
                    <!-- ================================================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mess Services"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"/>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breakfast"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lunch"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dinner"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Festival Special Meals"/>

                    <RadioGroup android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Veg"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Non-Veg"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Both"/>
                    </RadioGroup>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tiffin Service"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home Delivery"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trial Available"/>

                    <!-- ================================================= -->
                    <!-- TUITION -->
                    <!-- ================================================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuition / Coaching"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"/>

                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Whiteboard / Digital Board"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Printed Notes"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recorded Lectures"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doubt Solving Sessions"/>
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Test Series"/>

                    <RadioGroup android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Online"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hybrid"/>
                    </RadioGroup>

                    <!-- NEXT -->
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#2979FF"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
