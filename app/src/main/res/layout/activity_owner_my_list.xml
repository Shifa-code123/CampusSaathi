<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2196F3"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu"
                android:tint="@android:color/white"/>

            <TextView
                android:layout_centerInParent="true"
                android:text="My Listing"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

        <!-- SEARCH + ADD -->
        <LinearLayout
            android:layout_margin="12dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/edtSearch"
                android:layout_weight="1"
                android:hint="Search..."
                android:background="@drawable/edit_bg"
                android:padding="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnAddNew"
                android:text="+ Add New Listing"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:backgroundTint="#2979FF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- FILTER TABS -->
        <LinearLayout
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tabAll"
                android:text="All (3)"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/step_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tabVacant"
                android:text="Vacant (1)"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/step_inactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tabFull"
                android:text="Full (1)"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/step_inactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tabPending"
                android:text="Pending (1)"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/step_inactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- LISTING CARD -->
        <LinearLayout
            android:layout_margin="12dp"
            android:padding="12dp"
            android:background="@drawable/card_border"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_room1"/>

                <LinearLayout
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Green View PG"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="₹8,000 / month • 0.5 km from campus"
                        android:textSize="12sp"
                        android:textColor="#666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:text="Vacant"
                    android:textColor="#2E7D32"
                    android:padding="6dp"
                    android:background="@drawable/status_accepted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ACTION BUTTONS -->
            <LinearLayout
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:text="Mark Full"
                    android:textAllCaps="false"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2979FF"/>

                <Button
                    android:text="Edit Listing"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2979FF"/>
            </LinearLayout>

            <!-- HIDE -->
            <TextView
                android:layout_marginTop="6dp"
                android:text="👁 Hide"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <!-- LISTING CARD : FULL -->
        <LinearLayout
            android:padding="12dp"
            android:background="@drawable/card_border"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_room2"/>

                <LinearLayout
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise Hostel"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹6,500 / month • 0.8 km from campus"
                        android:textSize="12sp"
                        android:textColor="#666"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/status_rejected"
                    android:padding="6dp"/>
            </LinearLayout>


            <LinearLayout
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:text="Mark Vacant"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2979FF"/>

                <Button
                    android:text="Edit Listing"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2979FF"/>
            </LinearLayout>

            <TextView
                android:layout_height="wrap_content"
                android:text="👁 Hide"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_width="match_parent"/>
        </LinearLayout>
        <!-- LISTING CARD : PENDING -->
        <LinearLayout

            android:padding="12dp"
            android:background="@drawable/card_border"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_room3"/>

                <LinearLayout
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maple Rooms"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹7,500 / month • 1.0 km from campus"
                        android:textSize="12sp"
                        android:textColor="#666"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="#000"
                    android:background="@drawable/status_pending"
                    android:padding="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:text="Edit Listing"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2979FF"/>

                <Button
                    android:text="View Listing"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2979FF"/>
            </LinearLayout>

            <TextView
                android:layout_height="wrap_content"
                android:text="👁 Hide"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_width="match_parent"/>
        </LinearLayout>



        <!-- PHOTOS PREVIEW -->
        <LinearLayout
            android:padding="12dp"
            android:background="@drawable/card_border"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Photos"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/sample_room1"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:layout_marginStart="6dp"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/sample_room2"
                    android:scaleType="centerCrop"/>
                <ImageView
                    android:layout_marginStart="6dp"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/sample_room3"
                    android:scaleType="centerCrop"/>
                <ImageView
                    android:layout_marginStart="6dp"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/sample_room4"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add" />
            </LinearLayout>

            <TextView
                android:text="Edit"
                android:textColor="#2979FF"
                android:gravity="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
