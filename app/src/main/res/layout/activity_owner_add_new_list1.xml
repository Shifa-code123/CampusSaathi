<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOOLBAR ===== -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/owner_primary"
            app:title="Add New Listing"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_menu" />

        <!-- ===== BODY ===== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/owner_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New Listing"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/owner_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1 of 6: Basic Details"
                            android:textSize="12sp"
                            android:textColor="@color/owner_text_secondary"
                            android:layout_marginBottom="12dp" />

                        <!-- ===== STEPS (6) ===== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="1"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:background="@drawable/step_active" />

                            <View android:layout_width="16dp" android:layout_height="2dp" android:background="@color/owner_divider"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="2"
                                android:gravity="center" android:textColor="@color/owner_text_secondary" android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp" android:background="@color/owner_divider"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="3"
                                android:gravity="center" android:textColor="@color/owner_text_secondary" android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp" android:background="@color/owner_divider"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="4"
                                android:gravity="center" android:textColor="@color/owner_text_secondary" android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp" android:background="@color/owner_divider"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="5"
                                android:gravity="center" android:textColor="@color/owner_text_secondary" android:background="@drawable/step_inactive"/>

                            <View android:layout_width="16dp" android:layout_height="2dp" android:background="@color/owner_divider"/>

                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="6"
                                android:gravity="center" android:textColor="@color/owner_text_secondary" android:background="@drawable/step_inactive"/>
                        </LinearLayout>

                        <!-- ================================================= -->
                        <!-- =============== ROOM STEP 1 ===================== -->
                        <LinearLayout
                            android:id="@+id/layoutRoomStep1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/owner_text_primary"
                                android:text="Property Name *" />

                            <EditText
                                android:id="@+id/etPropertyName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter property name"
                                android:textColor="@color/owner_text_primary"
                                android:textColorHint="@color/owner_text_secondary"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Property Type *"
                                android:textColor="@color/owner_text_primary"
                                android:layout_marginTop="10dp" />

                            <RadioGroup
                                android:id="@+id/rgPropertyType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Room"/>

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="PG"/>

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Hostel"/>
                            </RadioGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender Allowed *"
                                android:textColor="@color/owner_text_primary"
                                android:layout_marginTop="10dp" />

                            <RadioGroup
                                android:id="@+id/rgGenderAllowed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Boys"/>

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Girls"/>

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Both"/>
                            </RadioGroup>

                        </LinearLayout>


                        <!-- ================================================= -->
                        <!-- =============== MESS STEP 1 ===================== -->
                        <LinearLayout
                            android:id="@+id/layoutMessStep1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/owner_text_primary"
                                android:text="Mess Name *"/>

                            <EditText
                                android:id="@+id/etMessName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter mess name"
                                android:textColor="@color/owner_text_primary"
                                android:textColorHint="@color/owner_text_secondary"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mess Type *"
                                android:textColor="@color/owner_text_primary"
                                android:layout_marginTop="10dp"/>

                            <RadioGroup
                                android:id="@+id/rgMessType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Veg"/>

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Non-Veg"/>

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/owner_text_primary"
                                    android:text="Both"/>
                            </RadioGroup>

                        </LinearLayout>


                        <!-- ================================================= -->
                        <!-- =============== TUITION STEP 1 ================== -->
                        <!-- ================================================= -->
                        <LinearLayout
                            android:id="@+id/layoutTuitionStep1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/owner_text_primary"
                                android:text="Tuition Name *"/>

                            <EditText
                                android:id="@+id/etTuitionName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter tuition name"
                                android:textColor="@color/owner_text_primary"
                                android:textColorHint="@color/owner_text_secondary"
                                android:background="@drawable/edit_bg"
                                android:padding="10dp"/>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/owner_text_primary"
                                android:text="Tuition Type *" android:layout_marginTop="10dp"/>

                            <RadioGroup
                                android:id="@+id/rgTuitionType"
                                android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/owner_text_primary" android:text="Home Tuition"/>
                                <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/owner_text_primary" android:text="Coaching Class"/>
                                <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/owner_text_primary" android:text="Online"/>
                            </RadioGroup>
                        </LinearLayout>

                        <!-- NEXT -->
                        <Button
                            android:id="@+id/btnNext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Next"
                            android:layout_marginTop="20dp"
                            android:backgroundTint="@color/owner_primary"
                            android:textColor="@color/white" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:itemBackground="@drawable/nav_item_background"
        app:menu="@menu/owner_menu_drawer"/>


</androidx.drawerlayout.widget.DrawerLayout>