<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ===== TOOLBAR ===== -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3"
        app:title="Add New Listing"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_menu" />

    <!-- ===== BODY ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add New Listing"
                        android:textStyle="bold"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 1 of 6: Basic Details"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="12dp" />

                    <!-- ===== STEPS (6) ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@drawable/step_active" />

                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="2"
                            android:gravity="center" android:background="@drawable/step_inactive"/>

                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="3"
                            android:gravity="center" android:background="@drawable/step_inactive"/>

                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="4"
                            android:gravity="center" android:background="@drawable/step_inactive"/>

                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="5"
                            android:gravity="center" android:background="@drawable/step_inactive"/>

                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#CCCCCC"/>

                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:text="6"
                            android:gravity="center" android:background="@drawable/step_inactive"/>
                    </LinearLayout>

                    <!-- ================================================= -->
                    <!-- =============== ROOM STEP 1 ===================== -->
                    <!-- ================================================= -->
                    <LinearLayout
                        android:id="@+id/layoutRoomStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Property Name *" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter property name"
                            android:background="@drawable/edit_bg"
                            android:padding="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Property Type *"
                            android:layout_marginTop="10dp" />

                        <RadioGroup
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Room"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PG"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hostel"/>
                        </RadioGroup>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gender Allowed *"
                            android:layout_marginTop="10dp" />

                        <RadioGroup
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Boys"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Girls"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Both"/>
                        </RadioGroup>
                    </LinearLayout>

                    <!-- ================================================= -->
                    <!-- =============== MESS STEP 1 ===================== -->
                    <!-- ================================================= -->
                    <LinearLayout
                        android:id="@+id/layoutMessStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mess Name *"/>

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter mess name"
                            android:background="@drawable/edit_bg"
                            android:padding="10dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mess Type *" android:layout_marginTop="10dp"/>

                        <RadioGroup android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Veg"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Non-Veg"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Both"/>
                        </RadioGroup>
                    </LinearLayout>

                    <!-- ================================================= -->
                    <!-- =============== TUITION STEP 1 ================== -->
                    <!-- ================================================= -->
                    <LinearLayout
                        android:id="@+id/layoutTuitionStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tuition Name *"/>

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter tuition name"
                            android:background="@drawable/edit_bg"
                            android:padding="10dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tuition Type *" android:layout_marginTop="10dp"/>

                        <RadioGroup android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home Tuition"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coaching Class"/>
                            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Online"/>
                        </RadioGroup>
                    </LinearLayout>

                    <!-- NEXT -->
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#2979FF"
                        android:textColor="#FFFFFF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
