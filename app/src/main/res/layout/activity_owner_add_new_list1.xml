<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- ===== TOOLBAR ===== -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3"
        app:title="Add New Listing"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_menu"/>

    <!-- ===== BODY ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add New Listing"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 1 of 5: Basic Property Details"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="12dp"/>

                    <!-- ===== STEPS ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@drawable/step_active"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView
                            android:text="2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView
                            android:text="3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView
                            android:text="4"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#CCCCCC"/>

                        <TextView
                            android:text="5"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/step_inactive"/>
                    </LinearLayout>

                    <!-- ===== FORM ===== -->
                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Enter Property Details"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Property Name *"
                        android:layout_marginTop="8dp"/>

                    <!-- Property Name -->
                    <EditText
                        android:id="@+id/etPropertyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter property name"
                        android:background="@drawable/edit_bg"
                        android:padding="10dp"/>

                    <!-- Property Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Property Type *"
                        android:layout_marginTop="10dp"/>

                    <RadioGroup
                        android:id="@+id/rgPropertyType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Room"/>

                        <RadioButton
                            android:id="@+id/rbPG"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PG"/>

                        <RadioButton
                            android:id="@+id/rbHostel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hostel"/>
                    </RadioGroup>

                    <!-- Gender Allowed -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender Allowed *"
                        android:layout_marginTop="10dp"/>

                    <RadioGroup
                        android:id="@+id/rgGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbBoys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boys"/>

                        <RadioButton
                            android:id="@+id/rbGirls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Girls"/>

                        <RadioButton
                            android:id="@+id/rbBoth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Both"/>
                    </RadioGroup>

                    <!-- Total Rooms / Beds -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Rooms / Beds *"
                        android:layout_marginTop="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_counter"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Minus -->
                        <TextView
                            android:id="@+id/btnMinus"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="-"
                            android:textSize="20sp"
                            android:textColor="#666666"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#DDDDDD"/>

                        <!-- Count -->
                        <TextView
                            android:id="@+id/txtCount"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#DDDDDD"/>

                        <!-- Plus -->
                        <TextView
                            android:id="@+id/btnPlus"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="20sp"
                            android:textColor="#666666"/>
                    </LinearLayout>

                    <!-- Next Button -->
                    <Button
                        android:id="@+id/btnNextStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#2979FF"
                        android:textColor="#FFFFFF"/>


                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
