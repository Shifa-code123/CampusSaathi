<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/owner_primary"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_centerInParent="true"
                android:text="Listing Submission"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

        <!-- MAIN CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/owner_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- APPROVED IMAGE -->
                <ImageView
                    android:id="@+id/ivStatus"
                    android:layout_width="160dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/illustration_approved" />

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_check_circle"
                    android:drawablePadding="6dp"
                    android:text="Approved"
                    android:textColor="@color/owner_success"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:text="Your listing is now live and visible to students."
                    android:textAlignment="center"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="13sp"/>

                <!-- BUTTONS -->
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnViewListing"
                        android:text="View Listing"
                        android:backgroundTint="@color/owner_primary"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnDashboard"
                        android:text="Go to Dashboard"
                        android:backgroundTint="@color/owner_accent"
                        android:textColor="@color/owner_text_primary"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_marginVertical="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/owner_divider"/>

                <!-- Location Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:text="Location"
                        android:textStyle="bold"
                        android:textColor="@color/owner_text_primary"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:id="@+id/btnEditLocation"
                        android:text="Edit"
                        android:textColor="@color/owner_primary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Location Details -->
                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:id="@+id/tvAddress"
                    android:layout_marginTop="4dp"
                    android:text="Shivaji Nagar"
                    android:textColor="@color/owner_text_primary"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:text="Landmark: Axis / MIDC Road"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:text="City: Khamgaon"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:text="Distance from Polytechnic: 0.5 km"
                    android:textSize="12sp"
                    android:textColor="@color/owner_text_secondary"/>

                <!-- Map -->
                <ImageView
                    android:id="@+id/ivMap"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/sample_map" />

                <View
                    android:layout_marginVertical="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/owner_divider"/>

                <!-- Photos Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Photos"
                        android:textColor="@color/owner_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:id="@+id/btnEditPhotos"
                        android:text="Edit"
                        android:textColor="@color/owner_primary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Photos -->
                <LinearLayout
                    android:id="@+id/layoutPhotos"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivPhoto1"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_room1"/>

                    <ImageView
                        android:id="@+id/ivPhoto2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_room2"/>

                    <ImageView
                        android:id="@+id/ivPhoto3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/sample_room3"
                        android:scaleType="center" />

                    <ImageView
                        android:id="@+id/ivPhoto4"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/sample_room4"
                        android:scaleType="center" />

                    <ImageView
                        android:id="@+id/btnAddPhoto"
                        android:layout_width="73dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/owner_primary" />

                </LinearLayout>

                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:id="@+id/tvStatusDesc"
                    android:layout_marginTop="6dp"
                    android:text="Note: Your listing is not yet visible to students.you will begin receiving request once it approved."
                    android:textAlignment="center"
                    android:textColor="@color/owner_text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>