<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F6FA">

        <!-- HEADER TOOLBAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2196F3"
            app:navigationIcon="@drawable/ic_menu">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">



                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Notification"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/headerProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/default_avatar"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>


        <!-- BODY + FOOTER CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="?attr/actionBarSize">

            <!-- BODY -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- YOUR EXISTING FORM CONTENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- FILTER -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="All"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="22dp"
                            android:background="@drawable/bg_tab_selected"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="New (5)"
                            android:textColor="#555"
                            android:gravity="center"
                            android:paddingHorizontal="22dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_tab_unselected"/>
                    </LinearLayout>


                    <!-- CARD 1 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/girl"/>

                            <TextView
                                android:layout_toEndOf="@id/headerProfile"
                                android:layout_marginStart="60dp"
                                android:text="Riya Sharma liked your post"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#222"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:layout_marginStart="60dp"
                                android:layout_marginTop="28dp"
                                android:text="5 minutes ago"
                                android:textSize="12sp"
                                android:textColor="#777"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <ImageView
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_heart"
                                android:layout_width="22dp"
                                android:layout_height="22dp"/>



                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Profile Image -->
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/profile2"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/building"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"/>

                            <!-- Title -->
                            <TextView
                                android:id="@+id/title2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/profile2"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/icon2"
                                android:text="May Tiffin Services accepted your listing request"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#222"/>

                            <!-- Time -->
                            <TextView
                                android:id="@+id/time2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/title2"
                                android:layout_alignStart="@id/title2"
                                android:layout_marginTop="4dp"
                                android:text="1 hour ago"
                                android:textSize="12sp"
                                android:textColor="#777"/>

                            <!-- Green Check Icon -->
                            <ImageView
                                android:id="@+id/icon2"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignTop="@id/title2"
                                android:src="@drawable/ic_check_circle"/>

                        </RelativeLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Profile Image -->
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/profile3"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/girl"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"/>

                            <!-- Title -->
                            <TextView
                                android:id="@+id/title3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/profile3"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/icon3"
                                android:text="Ananya Gupta submitted a request to follow you. Tap to view."
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#222"/>

                            <!-- Time -->
                            <TextView
                                android:id="@+id/time3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/title3"
                                android:layout_alignStart="@id/title3"
                                android:layout_marginTop="4dp"
                                android:text="2 hours ago"
                                android:textSize="12sp"
                                android:textColor="#777"/>

                            <!-- Follow Icon -->
                            <ImageView
                                android:id="@+id/icon3"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignTop="@id/title3"
                                android:src="@drawable/default_avatar"/>

                        </RelativeLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Book Image -->
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/profile4"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_book"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"/>

                            <!-- Title -->
                            <TextView
                                android:id="@+id/title4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/profile4"
                                android:layout_marginStart="12dp"
                                android:layout_toStartOf="@id/icon4"
                                android:text='BookStore verified your listing "Textbook Outlet for Engineering Students"'
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#222"/>

                            <!-- Time -->
                            <TextView
                                android:id="@+id/time4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/title4"
                                android:layout_alignStart="@id/title4"
                                android:layout_marginTop="4dp"
                                android:text="Yesterday"
                                android:textSize="12sp"
                                android:textColor="#777"/>

                            <!-- Orange Verified Icon -->
                            <ImageView
                                android:id="@+id/icon4"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignTop="@id/title4"
                                android:src="@drawable/ic_check_orange"/>

                        </RelativeLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Profile Image -->
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/profile5"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_rohit"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"/>

                            <!-- Comment Icon (Right Side) -->
                            <ImageView
                                android:id="@+id/icon5"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignTop="@id/profile5"
                                android:src="@drawable/ic_comment"/>

                            <!-- Title -->
                            <TextView
                                android:id="@+id/title5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/profile5"
                                android:layout_toStartOf="@id/icon5"
                                android:layout_marginStart="12dp"
                                android:text="Rohit Patel commented:"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#222"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <!-- Comment Text -->
                            <TextView
                                android:id="@+id/commentText5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/title5"
                                android:layout_alignStart="@id/title5"
                                android:layout_marginTop="4dp"
                                android:text='"Amazing food and great service!"'
                                android:textSize="14sp"
                                android:textColor="#444"
                                android:maxLines="2"
                                android:ellipsize="end"/>

                            <!-- Time -->
                            <TextView
                                android:id="@+id/time5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/commentText5"
                                android:layout_alignStart="@id/title5"
                                android:layout_marginTop="4dp"
                                android:text="Yesterday"
                                android:textSize="12sp"
                                android:textColor="#777"/>

                        </RelativeLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>


            </ScrollView>


            <!-- FOOTER -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@drawable/bottom_nav_bg"
                app:menu="@menu/owner_bottom_menu"
                app:itemIconTint="@color/bottom_nav_selector"
                app:itemTextColor="@color/bottom_nav_selector"
                app:labelVisibilityMode="labeled"/>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>


    <!-- DRAWER MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>