<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/adminVolunteerTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIndicatorColor="@color/admin_primary"
        app:tabSelectedTextColor="@color/admin_primary"
        app:tabTextColor="@color/admin_text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volunteer Requests" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="City Help Requests" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adminRvVolunteers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminVolunteerTabLayout" />

    <ProgressBar
        android:id="@+id/adminVolunteerProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminVolunteerTabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>