<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/drawer_border">

    <!-- 🔥 TOP HEADER -->
    <LinearLayout
        android:id="@+id/drawerTop"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/description_box"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/campus_logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CampusSaathi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/follow_button_blue"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- 🔥 PROFILE -->
    <LinearLayout
        android:id="@+id/profileSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/drawerTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profileImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/cs_primary"/>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Owner"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp"/>



    </LinearLayout>



    <!-- 🔥 MENU -->
    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/profileSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="6dp"/>

        <!-- My Services -->
        <TextView
            android:id="@+id/menuMyServices"
            style="@style/DrawerItemStyle"
            android:text="My Services"
            android:drawableStart="@drawable/ic_services"/>

        <!-- Verification -->


        <!-- Subscription -->
        <TextView
            android:drawableTint="@color/black"
            android:drawableStart="@drawable/ic_sub"
            android:id="@+id/menuSubscription"
            style="@style/DrawerItemStyle"
            android:text="Subscription (Coming Soon)"
            />
<!--        android:drawableStart="@drawable/ic_subscription"-->

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="6dp"/>

        <!-- Help -->
        <TextView
            android:drawableTint="@color/black"
            android:id="@+id/menuHelp"
            style="@style/DrawerItemStyle"
            android:text="Help and Support"
            android:drawableStart="@drawable/ic_support"/>

        <!-- About -->
        <TextView
            android:drawableTint="@color/black"
            android:id="@+id/menuAbout"
            style="@style/DrawerItemStyle"
            android:text="About CampusSaathi"
            android:drawableStart="@drawable/ic_cap"/>

        <!-- Dark Mode -->
        <TextView
            android:drawableStart="@drawable/ic_toggle_off"
            android:id="@+id/menuDarkMode"
            style="@style/DrawerItemStyle"
            android:text="Light / Dark Mode"
            android:drawableTint="@color/black"
            />
<!--        android:drawableStart="@drawable/ic_dark_mode"-->

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="6dp"/>

        <!-- Logout -->
        <TextView
            android:id="@+id/menuLogout"
            style="@style/DrawerItemStyle"
            android:text="Logout"
            android:drawableStart="@drawable/ic_logout"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>